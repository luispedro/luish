--- interactive
EDITOR=nvim exported
GOPATH=~/go:~/x exported
NUM=42 exported
LESS=-R exported
WORDCHARS=*?_-. local
PATH=~/bin:/b1:/usr/bin:/bin:/a1:/a2
--- from the cache
EDITOR=nvim exported
GOPATH=~/go:~/x exported
NUM=42 exported
LESS=-R exported
WORDCHARS=*?_-. local
PATH=~/bin:/b1:/usr/bin:/bin:/a1:/a2
--- a login shell that is not interactive: env and path only
EDITOR=nvim exported
GOPATH=~/go:~/x exported
NUM=42 exported
LESS=unset local
WORDCHARS=unset local
PATH=~/bin:/b1:/usr/bin:/bin:/a1:/a2
--- not -c or a script
EDITOR=unset local
GOPATH=unset local
NUM=unset local
LESS=unset local
WORDCHARS=unset local
PATH=/usr/bin:/bin
--- --no-rcs
EDITOR=unset local
GOPATH=unset local
NUM=unset local
LESS=unset local
WORDCHARS=unset local
PATH=/usr/bin:/bin
--- directories that PATH has already stay where they are
~/.local/bin:/env/bin:~/bin:/usr/bin:/bin:/opt/bin
~/.local/bin:/env/bin:~/bin:/usr/bin:/bin:/opt/bin
~/bin:~/.local/bin:/usr/bin:/bin:/opt/bin
~/bin:~/.local/bin:/usr/bin:/bin:/opt/bin
