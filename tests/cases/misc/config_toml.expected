--- an interactive shell reads it
unsetopt history.expand
setopt history.file='~/hist'
unsetopt history.ignore_space
unsetopt history.inc_append
unsetopt history.reduce_blanks
unsetopt history.save_no_dups
setopt history.share
setopt history.size='50'
unsetopt history.verify
unsetopt glob.bare_qualifiers
setopt glob.star
HISTFILE=~/hist
--- a script and -c do not
unsetopt history.expand
unsetopt history.ignore_space
unsetopt history.inc_append
unsetopt history.reduce_blanks
unsetopt history.save_no_dups
unsetopt history.share
unsetopt history.verify
unsetopt glob.bare_qualifiers
unsetopt glob.star
HISTFILE=
--- nor --no-rcs
unsetopt glob.bare_qualifiers
unsetopt glob.star
--- errors
luish: ~/.config/luish/config.toml: line 1: unknown key: top
luish: ~/.config/luish/config.toml: line 3: history.share: expected a boolean, found integer
luish: ~/.config/luish/config.toml: line 4: history.size: bad value: -3
luish: ~/.config/luish/config.toml: line 5: history.file: expected a string, found integer
luish: ~/.config/luish/config.toml: line 6: no such option: history.bogus
luish: ~/.config/luish/config.toml: line 8: history.reduce_blanks: expected a boolean, found string
luish: ~/.config/luish/config.toml: line 9: no such group: nosuch
luish: ~/.config/luish/config.toml: line 14: no such option: cd
unsetopt history.expand
unsetopt history.ignore_space
unsetopt history.inc_append
unsetopt history.reduce_blanks
unsetopt history.save_no_dups
setopt history.save_size='20'
unsetopt history.share
unsetopt history.verify
unsetopt glob.bare_qualifiers
setopt glob.star
--- not TOML
luish: ~/.config/luish/config.toml: line 3: duplicate key: `star`
unsetopt glob.bare_qualifiers
unsetopt glob.star
luish: ~/.config/luish/config.toml: line 1: expected a right bracket, found a newline
unsetopt glob.bare_qualifiers
unsetopt glob.star
luish: ~/.config/luish/config.toml: line 2: no such option: history
luish: ~/.config/luish/config.toml: line 3: unknown key: x
unsetopt glob.bare_qualifiers
unsetopt glob.star
--- with rc.d: before it, and cached with it
luish: ~/.config/luish/config.toml: line 3: no such option: glob.bogus
rc.d sees star=1 HISTSIZE=50
unsetopt glob.bare_qualifiers
setopt glob.star
HISTSIZE=5
unsetopt glob.bare_qualifiers
setopt glob.star
HISTSIZE=5
--- a changed file is read again
rc.d sees star=0 HISTSIZE=
setopt glob.bare_qualifiers
unsetopt glob.star
HISTSIZE=5
setopt glob.bare_qualifiers
unsetopt glob.star
HISTSIZE=5
--- and so is a removed one
rc.d sees star=0 HISTSIZE=
unsetopt glob.bare_qualifiers
unsetopt glob.star
HISTSIZE=5
--- or a new one
rc.d sees star=0 HISTSIZE=
setopt cd.auto
setopt cd.auto
--- a setting by its own name, directly under options
rc.d sees star=1 HISTSIZE=
setopt editor.autosuggest
unsetopt glob.bare_qualifiers
setopt glob.star
--- aliases, with global and suffix ones in their own tables
luish: ~/.config/luish/config.toml: line 4: alias.bad: expected a string, found integer
luish: ~/.config/luish/config.toml: line 5: alias: bad alias name: "a=b"
luish: ~/.config/luish/config.toml: line 8: alias.global.N: expected a string, found integer
rc.d sees star=0 HISTSIZE=
alias ..='echo up'
alias -g U='| tr a-z A-Z'
alias ll='echo ll'
alias -s txt='echo TXT'
LL
up
TXT a.txt
alias ..='echo up'
alias -g U='| tr a-z A-Z'
alias ll='echo ll'
alias -s txt='echo TXT'
LL
up
TXT a.txt
luish: ~/.config/luish/config.toml: line 3: alias.suffix: expected a string, found array
rc.d sees star=0 HISTSIZE=
global='echo g'
--- key bindings, by name or as sequences
luish: ~/.config/luish/config.toml: line 5: bindkey.Down: expected a string, found integer
luish: ~/.config/luish/config.toml: line 6: bindkey.Ctrl-Tab: invalid key: Ctrl-Tab
luish: ~/.config/luish/config.toml: line 7: bindkey.^W: no such widget `nosuch'
rc.d sees star=0 HISTSIZE=
bindkey "^[[A" up-line-or-history
"^X^E" undo
"^[[B" down-line-or-history
bindkey "^[[A" up-line-or-history
"^X^E" undo
"^[[B" down-line-or-history
