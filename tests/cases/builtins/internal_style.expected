--- a name, with where it comes from
keyword bold blue
  keyword: bold blue (scheme default-dark)
command.alias italic green
  command.alias: italic green (scheme default-dark)
  command: green (scheme default-dark)
--- setting one, over the scheme
command.alias bold green
  command.alias: bold (set by the user)
  command: green (scheme default-dark)
comment italic no-dim bright-black bg:#102030
  comment: italic no-dim bright-black bg:#102030 (set by the user)
git.branch.dirty sgr:1;38;5;208
  git.branch: sgr:1;38;5;208 (set by the user)
--- plain stops the fallback
command.function plain
  command.function: plain (set by the user)
--- errors
