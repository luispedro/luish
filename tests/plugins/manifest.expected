--- builds the cache
dep
p extension
luish: ~/.config/luish/plugins/p/plugin.toml: line 7: no such option: nosuch
luish: ~/.config/luish/plugins/p/plugin.toml: line 10: alias.bad: expected a string, found integer
luish: ~/.config/luish/plugins/p/plugin.toml: line 17: bindkey.Up: no such widget `nosuch'
p rc.lsh: ll='echo ll' setopt glob.star
q
setopt editor.autosuggest
alias -g U='| tr a-z A-Z'
alias ll='echo ll'
alias qq='echo qq'
alias -s txt='echo TXT'
LL
TXT a.txt
qq
"^X^E" undo
--- uses it
p extension
setopt editor.autosuggest
alias -g U='| tr a-z A-Z'
alias ll='echo ll'
alias qq='echo qq'
alias -s txt='echo TXT'
LL
TXT a.txt
qq
"^X^E" undo
--- a changed plugin.toml, of a plugin that rc.d loads, is read again
dep
p extension
luish: ~/.config/luish/plugins/p/plugin.toml: line 7: no such option: nosuch
luish: ~/.config/luish/plugins/p/plugin.toml: line 10: alias.bad: expected a string, found integer
luish: ~/.config/luish/plugins/p/plugin.toml: line 17: bindkey.Up: no such widget `nosuch'
p rc.lsh: ll='echo ll' setopt glob.star
q
qq2
p extension
qq2
--- not in a script
dep
p extension
unsetopt glob.bare_qualifiers
unsetopt glob.star
status 0
