* in d: ["[x]", "__pycache__", "a.fa", "afa-link", "b.fa.gz", "broken", "c.txt", "link", "sub", "{lit}.fa"]
*(/) in d: ["[x]", "__pycache__", "sub"]
*(-/) in d: ["[x]", "__pycache__", "link", "sub"]
*(-/M) in d: ["[x]/", "__pycache__/", "link/", "sub/"]
*(.) in d: ["a.fa", "b.fa.gz", "c.txt", "{lit}.fa"]
*(-.) in d: ["a.fa", "afa-link", "b.fa.gz", "c.txt", "{lit}.fa"]
*(@) in d: ["afa-link", "broken", "link"]
*(^/) in d: ["a.fa", "afa-link", "b.fa.gz", "broken", "c.txt", "link", "{lit}.fa"]
*(T) in d: ["[x]/", "__pycache__/", "a.fa ", "afa-link@", "b.fa.gz ", "broken@", "c.txt ", "link@", "sub/", "{lit}.fa "]
*(D) in d: [".hidden.fa", "[x]", "__pycache__", "a.fa", "afa-link", "b.fa.gz", "broken", "c.txt", "link", "sub", "{lit}.fa"]
.* in d: [".hidden.fa"]
*.{fa,fasta}{,.gz} in d: ["a.fa", "b.fa.gz", "{lit}.fa"]
*.{fa,fa} in d: ["a.fa", "{lit}.fa"]
*/*.fa in d: ["[x]/z.fa", "link/x.fa", "sub/x.fa"]
**/*.fa in d: ["[x]/z.fa", "a.fa", "sub/deep/y.fa", "sub/x.fa", "{lit}.fa"]
**/*.fa(:t) in d: ["z.fa", "a.fa", "y.fa", "x.fa", "{lit}.fa"]
*.fa(:r) in d: ["a", "{lit}"]
\{lit\}.fa in d: ["{lit}.fa"]
{lit}.fa in d: ["{lit}.fa"]
* in nowhere: []
sub in d: ["sub"]
sub(.) in d: []
missing in d: []
d/*.fa in : ["d/a.fa", "d/{lit}.fa"]
*.fa in d/: ["a.fa", "{lit}.fa"]
*.fa in d/[x]: ["z.fa"]
*(N) in d/sub/deep: ["y.fa"]
*(On[0]) in d/sub: ["x.fa"]
*(on) in d/sub: ["deep", "x.fa"]
["d/[x]", "d/__pycache__", "d/sub"]
glob: *(Z): bad glob qualifier: unknown file attribute: Z
load: 0
[x]/ __pycache__/ link/ sub/ [x]/z.fa a.fa sub/deep/y.fa sub/x.fa {lit}.fa a.fa {lit}.fa b.fa.gz *.fasta *.fasta.gz
