# Written by luish (plugin sync, plugin update). Don't edit.
version = 1

[[plugin]]
name = "extra/complete/bio"
source = "extra"
path = "complete/bio.lsh"
dependencies = []

[[plugin]]
name = "personal"
source = "~/src/personal"
path = "."
dependencies = ["complete/bio"]

[[available]]
name = "extra"
declared-by = "personal"
path = "~/src/extra"
