=== style
--- style -
--clear 	remove all styles, and choose no scheme
--detect 	ask the terminal for its background again
--terminal-colors 	whether schemes set the terminal's colours
-c 	choose a colour scheme (or list them)
-d 	set or remove a default, under the scheme
-p 	print commands that recreate the styles
-r 	remove the styles of the names
-s 	define or change a colour scheme
status 0
--- style -c 
default-dark 	in use
default-light 
status 0
--- style -c default-dark default-l
default-light 
status 0
--- style -c a b c 
status 1
--- style --terminal-colors 
off 
on 
status 0
--- style command.a
command.alias 	italic green
status 0
--- style comment it
italic 
status 0
--- style comment no-b
no-blink 
no-bold 
status 0
--- style comment bold bg:bright-r
bg:bright-red 
status 0
--- style comment 'bold ul:re
'bold ul:red' 
status 0
--- style -r comm
command 	green
command.alias 	italic green
command.builtin 	green
command.directory 	green
command.external 	green
command.function 	bold green
command.history 	green
command.precommand 	green
command.unknown 	bold red
comment 	bright-black
status 0
--- style -d -
-r 	remove the defaults of the names
status 0
--- style -d -r command.u
command.unknown 	bold red
status 0
--- style -s default-dark -
--delete 	remove the scheme
-i 	set the scheme it inherits from
-r 	remove styles from the scheme
status 0
--- style -s default-dark -i 
default-dark 	in use
default-light 
status 0
--- style -s default-dark command.f
command.function 	bold green
status 0
--- style -s default-dark terminal.b
terminal.background 	the terminal's colour
status 0
--- style -s default-dark terminal.background 
status 1
--- style --clear 
status 1
